{
  "name": "sheetdelta-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Excel and CSV toolkit: compare, validate, clean, merge, calculate formulas, preserve templates and stream records with selective ESM imports.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compare": {
      "types": "./dist/compare.d.ts",
      "import": "./dist/compare.js",
      "default": "./dist/compare.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js",
      "default": "./dist/csv.js"
    },
    "./excel": {
      "types": "./dist/excel.d.ts",
      "import": "./dist/excel.js",
      "default": "./dist/excel.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js",
      "default": "./dist/validate.js"
    },
    "./clean": {
      "types": "./dist/clean.d.ts",
      "import": "./dist/clean.js",
      "default": "./dist/clean.js"
    },
    "./merge": {
      "types": "./dist/merge.d.ts",
      "import": "./dist/merge.js",
      "default": "./dist/merge.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./formula": {
      "types": "./dist/formula.d.ts",
      "import": "./dist/formula.js",
      "default": "./dist/formula.js"
    },
    "./workbook": {
      "types": "./dist/workbook.d.ts",
      "import": "./dist/workbook.js",
      "default": "./dist/workbook.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js",
      "default": "./dist/stream.js"
    },
    "./excel-stream": {
      "types": "./dist/excel-stream.d.ts",
      "import": "./dist/excel-stream.js",
      "default": "./dist/excel-stream.js"
    },
    "./excel-node": {
      "types": "./dist/excel-node.d.ts",
      "import": "./dist/excel-node.js",
      "default": "./dist/excel-node.js"
    },
    "./import": {
      "types": "./dist/import.d.ts",
      "import": "./dist/import.js",
      "default": "./dist/import.js"
    },
    "./import-report": {
      "types": "./dist/import-report.d.ts",
      "import": "./dist/import-report.js",
      "default": "./dist/import-report.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "csv",
    "diff",
    "table",
    "compare",
    "typescript",
    "spreadsheet",
    "excel",
    "xlsx",
    "validation",
    "deduplicate",
    "merge",
    "report",
    "formula",
    "streaming",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyyz1011/sheetdelta.git",
    "directory": "packages/core"
  },
  "homepage": "https://sheetdelta.nimokit.com/docs/",
  "bugs": {
    "url": "https://github.com/yyyz1011/sheetdelta/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "papaparse": "5.5.3",
    "saxes": "6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/yauzl": "^3.4.0"
  }
}
